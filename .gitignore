# secrets never touch the repo
.env
*.env
*token*
*secret*
*.key
*.pem
# VIP phrase lists — never commit these (the .example ships, yours stays local)
viplist.txt
phrases*.txt
# local backups of the above — also never commit
*.bak
# live setup (the .example ships, yours stays local)
bouncer.conf
# runtime
__pycache__/
*.log
*.pid
.DS_Store
# spent one-shot labels — written automatically on every burn, never commit
burned.txt
# local promo cards (X marketing) — generated, never commit
poli-x-*.png
